# EMR API — environment contract (see src/ for reads).
# Copy to .env and fill in. Never commit real secrets.

# ── Core ────────────────────────────────────────────────────
PORT=8093
NODE_ENV=development
LOG_LEVEL=info

# ── Database (Postgres) ─────────────────────────────────────
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=9000
DB_USER=postgres
DB_PASSWORD=
DB_NAME=emr
DB_SYNCHRONIZE=true
# Destructive: drops and recreates the schema on boot.
DB_DROP_SCHEMA=false
TYPEORM_LOGGING=false

# ── Auth ────────────────────────────────────────────────────
# Shared JWT signing secret — MUST match identity (the token issuer).
# No code fallback: authenticated requests fail closed (500) when unset.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Used by the identity proxy for service-to-service calls.
INTERNAL_API_KEY=
INTEROP_API_KEY=
# Never enable outside local development.
SKIP_AUTH=false

# ── Cross-service URLs ──────────────────────────────────────
IDENTITY_SERVICE_URL=http://localhost:8001
RXSOFT_API_URL=http://localhost:8002/api
CONVERSATION_API_URL=http://localhost:8004/api
# LIS endpoints are exposed under /lis/*, so no /api suffix here.
EMR_LIS_API_URL=http://localhost:8003
# RxSoft backend has a global /api prefix.
EMR_PHARMACY_API_URL=http://localhost:8002/api
# order = legacy storefront orders; prescription = pharmacy prescriptions.
EMR_PHARMACY_SYNC_MODE=prescription
EMR_PHARMACY_PAYMENT_METHOD=cash

# ── Media / print ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PRINT_PREFIX=
PRINT_STORAGE_PATH=

# ── Dev only ────────────────────────────────────────────────
SEED_ON_START=false
